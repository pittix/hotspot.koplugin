# hostapd build configuration for hostapd.musl (used by tools/build-hostapd-musl.sh).
#
# Taken unchanged from build/hostapd.defconfig in kindshare by unrealJune
# (https://github.com/unrealJune/kindshare), which was verified end to end on a
# Kindle Voyage (AR6003 / ath6kl_sdio, kernel 3.0.35-lab126).
# kindshare is MIT licensed, Copyright (c) 2026 June Philip.

# The only driver needed: ath6kl is fullmac and speaks nl80211.
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y

# AR6003 is single-stream 802.11n on 2.4 GHz (the plugin still runs it as plain 11g).
CONFIG_IEEE80211N=y

# Control interface, so hostapd_cli or scripts can drive it.
CONFIG_CTRL_IFACE=y

# Internal crypto: no OpenSSL. Enough for WPA2-PSK; no EAP/RADIUS needed.
CONFIG_TLS=internal
CONFIG_INTERNAL_LIBTOMMATH=y

# Strip everything enterprise-shaped to keep the binary small.
CONFIG_NO_RADIUS=y
CONFIG_NO_ACCOUNTING=y
CONFIG_NO_VLAN=y
CONFIG_NO_DUMP_STATE=y
